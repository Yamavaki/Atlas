{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "1.28.0",
  "identifier": "com.yamavaki.atlas",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atlas",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Notas, mapas e campanhas para RPG",
    "license": "GPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
